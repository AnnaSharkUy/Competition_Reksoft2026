# Copy to .env. Do not commit .env and do not paste passwords into tests.
# BASE_URL is the how-to alias. Origin only, without /Library.
BASE_URL=https://dam.rex.lab.reksoft.com
DAM_UI_BASE=https://dam.rex.lab.reksoft.com
DAM_API_BASE=http://dam.svc.rex.lab.reksoft.com

# UI login. Password grant is an external IdP, not a DAM OpenAPI route.
DAM_USER=
DAM_PASSWORD=

# API auth: Bearer or X-Api-Key. Either one is enough for read-only API smoke.
DAM_TOKEN=
DAM_API_KEY=
